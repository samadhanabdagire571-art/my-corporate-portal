# ==============================================================================
# Corporate Employee & Intern Work Management Portal - Environment Variables
# Enterprise Production & Local Configuration Blueprint
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# PostgreSQL / Supabase Database Connection String
# Example: postgresql://postgres:password@localhost:5432/corporate_portal
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret & Token Expiration
JWT_SECRET=super-secure-corporate-jwt-secret-key-production-ready-32-chars-minimum
JWT_EXPIRES_IN=7d

# Django Auxiliary API Service (Optional)
DJANGO_API_URL=http://localhost:8000

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Storage & Limits
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,zip,png,jpg,jpeg,docx,xlsx,csv,txt

# Part 5: Redis Caching & In-Memory Fallback
REDIS_URL=redis://localhost:6379

# Part 5: AI Corporate Work Assistant Provider
AI_PROVIDER=local-rules
AI_API_KEY=your-ai-api-key-here

# Part 5: API Gateway Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
